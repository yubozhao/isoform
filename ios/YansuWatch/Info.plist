<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Isoform</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.isoform.companion.watchkitapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>isoformwatch</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Isoform reads your heart rate while you record, so your brief can tell how intense the moment was. It never writes to Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Isoform notes roughly where you are while you record, to about a kilometer, so your brief can say where a conversation happened. The area name comes from Apple Maps.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Isoform does not write to Health. It only reads your heart rate while you record.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Isoform records when you tap record, and sends the recording to your computer.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.isoform.companion</string>
</dict>
</plist>
