    "What Isoform moved": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What Isoform moved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 的进展"}}}},
    "Worked on today": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Worked on today"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"今天处理过的"}}}},
