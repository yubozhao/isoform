    "Your computer stops sending briefs to this phone, and briefs stored on this phone are deleted.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer stops sending briefs to this phone, and briefs stored on this phone are deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑将停止向这部手机发送简报，这部手机上保存的简报也会被删除。"}}}},
    "Remove saved pairing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove saved pairing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除已保存的配对"}}}},
    "This removes the saved pairing and cached briefs and chats from this phone. The old phone may still be listed in Isoform on your computer under Settings > Phone. Then choose Show pairing code on your computer to pair this phone again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This removes the saved pairing and cached briefs and chats from this phone. The old phone may still be listed in Isoform on your computer under Settings > Phone. Then choose Show pairing code on your computer to pair this phone again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从这部手机上移除已保存的配对，以及缓存的简报和聊天。旧手机可能仍列在电脑上 Isoform 的“设置 > 手机”中。之后在电脑上选择“显示配对码”，即可重新配对这部手机。"}}}},
    "Briefs stay on your computer. This phone downloads them again when it is paired and online.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Briefs stay on your computer. This phone downloads them again when it is paired and online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"简报仍保存在电脑上。这部手机配对并联网后会重新下载。"}}}},
    "Remove from this phone": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove from this phone"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从这部手机移除"}}}},
    "Keep pairing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep pairing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留配对"}}}},
    "The pairing was not removed from the relay. You can remove it from this phone now, then remove this phone in the Isoform app on your computer.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The pairing was not removed from the relay. You can remove it from this phone now, then remove this phone in the Isoform app on your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配对未从中继服务器移除。你可以现在从这部手机移除，然后在电脑上的 Isoform 应用中移除这部手机。"}}}},
    "Isoform could not remove the saved pairing from this phone. Unlock your phone and try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform could not remove the saved pairing from this phone. Unlock your phone and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 无法从这部手机移除已保存的配对。请解锁手机后重试。"}}}},
    "Set a passcode on this iPhone, then try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Set a passcode on this iPhone, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先为这部 iPhone 设置密码，然后重试。"}}}},
    "Saved pairing unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved pairing unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存的配对不可用"}}}},
    "Retry saved pairing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry saved pairing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试已保存的配对"}}}},
    "Choose Pair again below to use Chat, corrections, one-time work and Today feedback.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Pair again below to use Chat, corrections, one-time work and Today feedback."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在下方选择“重新配对”，即可使用聊天、更正、一次性任务和今日反馈。"}}}},
    "Alerts on this phone show a short line only. Pair this phone again in Settings to restore the details.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Alerts on this phone show a short line only. Pair this phone again in Settings to restore the details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这部手机上的提醒只显示简短一行。请在设置中重新配对这部手机，以恢复详细内容。"}}}},
    "This phone is not paired with a computer.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This phone is not paired with a computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这部手机尚未与电脑配对。"}}}},
    "Pairing needs the Isoform app on your computer. Isoform shows a six-digit code on both devices. Compare them, then approve on the computer.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing needs the Isoform app on your computer. Isoform shows a six-digit code on both devices. Compare them, then approve on the computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配对需要电脑上的 Isoform 应用。Isoform 会在两台设备上显示六位数字码。请比对两边的码，然后在电脑上批准。"}}}},
    "Isoform does this once on your computer. Check Tasks for its status.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform does this once on your computer. Check Tasks for its status."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 会在电脑上完成这件事一次。可在“任务”中查看状态。"}}}},
    "Start one-time work": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Start one-time work"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始一次性任务"}}}},
    "Briefs and deliverables saved on this phone.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Briefs and deliverables saved on this phone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存在这部手机上的简报和交付物。"}}}},
    "Sensitive, private, or paused activity is excluded from this brief.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sensitive, private, or paused activity is excluded from this brief."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"敏感、私密或已暂停的活动不会计入这份简报。"}}}},
    "Slipping": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Slipping"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"有延误"}}}},
    "Due today": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Due today"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"今天到期"}}}},
    "No recorded touch": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No recorded touch"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有记录的接触"}}}},
