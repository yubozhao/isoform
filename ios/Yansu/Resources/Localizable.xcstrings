    "sees.contacts": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Contacts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通讯录"}}}},
    "sees.mail.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reads your mail and writes drafts. Sends only when you tap Send."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"读你的邮件、写草稿。只有你点“发送”才会发出。"}}}},
    "sees.mail.off": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't see your mail yet, so there are no drafts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还看不到你的邮件，所以没有草稿。"}}}},
    "sees.calendar.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sees your events and free time. Adds a hold only when you say so."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"看你的日程和空闲时间。只有你同意才会占用时间。"}}}},
    "sees.calendar.off": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't see your calendar yet, so briefs start without your day."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还看不到你的日历，所以简报不会讲你的一天。"}}}},
    "sees.calls.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hears them to take notes. Audio stays on your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"听通话来记笔记。音频留在你的电脑上。"}}}},
    "sees.calls.off": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't hear your calls yet, so meetings have no notes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还听不到你的通话，所以会议没有笔记。"}}}},
    "sees.screen.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sees the app and window you're in. Screenshots stay on your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"看你正在用的应用和窗口。截图留在你的电脑上。"}}}},
    "sees.screen.off": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't see your screen yet, so Isoform doesn't know what you work on."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还看不到你的屏幕，所以 Isoform 不知道你在做什么。"}}}},
    "sees.assistant.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reads its last 30 days and runs the tasks you start."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"读最近 30 天的记录，运行你开始的任务。"}}}},
    "sees.contacts.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Knows people by name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按名字认得人。"}}}},
    "sees.contacts.off": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't see your contacts yet, so people show by email address."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还看不到你的通讯录，所以人会以邮箱地址显示。"}}}},
    "sees.on": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"On"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已打开"}}}},
    "sees.turnOn": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn on"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开"}}}},
    "sees.leaves.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What leaves your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"什么会离开你的电脑"}}}},
    "sees.leaves.ai.claude": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The text a task needs, to your AI, Claude Code."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"任务需要的文字，发给你的 AI：Claude Code。"}}}},
    "sees.leaves.ai.codex": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The text a task needs, to your AI, Codex."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"任务需要的文字，发给你的 AI：Codex。"}}}},
    "sees.leaves.ai.isoform": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The text a task needs, to the AI Isoform uses."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"任务需要的文字，发给 Isoform 使用的 AI。"}}}},
    "sees.leaves.phone": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your briefs, cards and drafts, to this phone, encrypted end to end."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"简报、卡片和草稿，发到这部手机，端到端加密。"}}}},
    "sees.leaves.never": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Screenshots and audio never leave your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"截图和音频永远不会离开你的电脑。"}}}},
    "sees.tap.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Only with your tap"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有你点了才会做"}}}},
    "sees.tap.line": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform doesn't send, delete or accept anything until you tap."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你点之前，Isoform 不会发送、删除或接受任何东西。"}}}},
    "sees.foot": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Change these in Isoform on your computer › Settings › Privacy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在电脑上的 Isoform › 设置 › 隐私 里修改。"}}}}
  },
  "version": "1.0"
}
