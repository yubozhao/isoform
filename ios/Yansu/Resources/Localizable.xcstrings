    "Claude Code on your computer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Claude Code on your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑上的 Claude Code"}}}},
    "Codex on your computer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Codex on your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑上的 Codex"}}}},
