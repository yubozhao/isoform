    "Nothing running right now": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing running right now"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前没有进行中的任务"}}}},
    "Open Settings and choose Pair again. Your tasks stay on your computer until then.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings and choose Pair again. Your tasks stay on your computer until then."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开设置并选择重新配对。在此之前，你的任务仍保存在电脑上。"}}}},
    "Pair this phone again to see tasks.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair this phone again to see tasks."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新配对此手机以查看任务。"}}}},
    "Pair your phone with your computer to see tasks.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair your phone with your computer to see tasks."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将手机与你的电脑配对以查看任务。"}}}},
    "See all %d": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"See all %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看全部 %d 项"}}}},
    "Show less": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show less"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收起"}}}},
    "Your computer is offline. Tasks saved on this phone are still here.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is offline. Tasks saved on this phone are still here."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已离线。保存在手机上的任务仍可查看。"}}}},
    "Your work stays on your computer until you pair.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your work stays on your computer until you pair."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配对前，你的工作内容会保留在电脑上。"}}}},
