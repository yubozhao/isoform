    "Deliverables": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Deliverables"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"交付物"}}}},
    "No open loops right now.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No open loops right now."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前没有未完结的事项。"}}}},
    "Most used apps": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Most used apps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最常用的应用"}}}},
    "Not enough activity to show a day shape yet.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Not enough activity to show a day shape yet."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活动还不够多，暂时无法显示一天的轮廓。"}}}},
    "Isoform observed these items. It does not know why you did them unless you told it.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform observed these items. It does not know why you did them unless you told it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 观察到了这些事项。除非你告诉过它，否则它不知道你为什么这样做。"}}}},
    "Isoform cannot find the sources for this item.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform cannot find the sources for this item."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 找不到这一项的来源。"}}}},
    "On your computer, open Isoform, go to Settings > Phone, then under Pair a phone choose Show pairing code. The pairing code expires after 10 minutes.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"On your computer, open Isoform, go to Settings > Phone, then under Pair a phone choose Show pairing code. The pairing code expires after 10 minutes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在电脑上打开 Isoform，进入“设置 > 手机”，在“配对手机”下选择“显示配对码”。配对码 10 分钟后失效。"}}}},
    "To replace an existing pairing, choose Pair again in this phone's Settings. Your current pairing keeps working until the new pairing is saved.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"To replace an existing pairing, choose Pair again in this phone's Settings. Your current pairing keeps working until the new pairing is saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"要替换现有配对，请在这部手机的“设置”中选择“重新配对”。新配对保存之前，当前配对仍可继续使用。"}}}},
    "Stop scanning": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Stop scanning"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"停止扫描"}}}},
    "Scan the code from your computer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scan the code from your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"扫描电脑上的码"}}}},
    "Pair with this link": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair with this link"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用此链接配对"}}}},
    "Keep this screen open until your computer shows the code.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep this screen open until your computer shows the code."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请保持此页面打开，直到电脑显示配对码。"}}}},
    "Compare this code with your computer, then approve there.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compare this code with your computer, then approve there."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将此码与电脑比对，然后在电脑上批准。"}}}},
    "Pairing ends when your computer approves, declines, or the code expires.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing ends when your computer approves, declines, or the code expires."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电脑批准、拒绝或配对码失效时，配对即告结束。"}}}},
    "Cancel pairing": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel pairing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消配对"}}}},
    "Dismiss": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}}}},
