    "%@ · %@ need you": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · %@ need you"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ · %@ 项需要你"}}}},
