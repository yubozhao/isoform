    "Waiting to start on your computer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting to start on your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待在电脑上开始"}}}},
