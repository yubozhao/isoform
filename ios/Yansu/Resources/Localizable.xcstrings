{
  "sourceLanguage": "en",
  "strings": {
    "Turn off Your week notifications" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn off Your week notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭“你的一周”通知"}}}},
    "Turn on Your week notifications" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn on Your week notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开“你的一周”通知"}}}},
    "Recording on its way" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recording on its way"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音即将就绪"}}}},
    "Pair this phone with the Isoform app on your computer. Everything is encrypted between this phone and your computer." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair this phone with the Isoform app on your computer. Everything is encrypted between this phone and your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将这部手机与电脑上的 Isoform 应用配对。这部手机和你的电脑之间的所有内容都经过加密。"}}}},
    "This phone's pairing couldn't be read. Pair again." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This phone's pairing couldn't be read. Pair again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取这部手机的配对信息。请重新配对。"}}}},
    "Your phone checks your computer every so often, so a notice can come a little late. While your computer is asleep, most notices wait until it wakes." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your phone checks your computer every so often, so a notice can come a little late. While your computer is asleep, most notices wait until it wakes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的手机会不时检查你的电脑，所以通知可能会稍晚一些到。电脑睡眠时，大多数通知会等它唤醒后再到。"}}}},
    "Can't tell right now" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't tell right now"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法确定"}}}},
    "Can't tell right now · last heard %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can't tell right now · last heard %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法确定 · 上次联系于 %@"}}}},
    "Remove saved briefs" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove saved briefs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除已保存的简报"}}}},
    "Remove saved briefs?" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove saved briefs?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除已保存的简报？"}}}},
    "Briefs, chats, tasks and ideas you have opened are saved on this iPhone." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Briefs, chats, tasks and ideas you have opened are saved on this iPhone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你打开过的简报、聊天、任务和想法会保存在这部 iPhone 上。"}}}},
    "Soon, people can hire your Agent of You." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Soon, people can hire your Agent of You."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"很快，别人就能雇用你的 Agent of You。"}}}},
    "Send again" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Send again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"再次发送"}}}},
    "Show" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看"}}}},
    "Waits for your computer" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Waits for your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待电脑连接"}}}},
    "You can still ask and act. Isoform does it when your computer wakes." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You can still ask and act. Isoform does it when your computer wakes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你仍然可以提问和操作。电脑唤醒后 Isoform 会完成。"}}}},
    "%@ is signed out on your computer. Briefs are shorter until you sign in there." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is signed out on your computer. Briefs are shorter until you sign in there."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 在你的电脑上已退出登录。在电脑上登录之前，简报会更简短。"}}}},
    "brief.stamp.dayAndTime" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ at %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$@ %2$@"}}}},
    "Couldn't reach your computer." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't reach your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接你的电脑。"}}}},
    "Ask Isoform anything. It answers from your computer." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask Isoform anything. It answers from your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"向 Isoform 提出任何问题。它会在你的电脑上回答。"}}}},
    "Update Isoform on your computer to send from here." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Update Isoform on your computer to send from here."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请在电脑上更新 Isoform，才能从这里发送。"}}}},
    "connection.asleepAsOf" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Asleep as of %1$@ · %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"截至%1$@仍在睡眠 · %2$@"}}}},
    "connection.sleepingSince" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Asleep since %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从%@起睡眠"}}}},
    "notifications.couldNotReach" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't reach your computer. These choices come from it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接你的电脑。这些选项来自电脑。"}}}},
    "notifications.alertsOff" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn on phone alerts first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先打开手机提醒。"}}}},
    "Refresh this brief from your computer to talk about it on your phone." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh this brief from your computer to talk about it on your phone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请从电脑刷新这份简报，然后在手机上讨论。"}}}},
    "Couldn't get today's brief from %@." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't get today's brief from %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还没能从 %@ 获取今天的简报。"}}}},
    "Couldn't get today's brief from %@ yet. Trying again." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't get today's brief from %@ yet. Trying again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还没能从 %@ 获取今天的简报，正在重试。"}}}},
    "Getting your brief from %@…" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Getting your brief from %@…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在从 %@ 获取你的简报…"}}}},
    "Your first brief comes at %@." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your first brief comes at %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的第一份简报将在%@送达。"}}}},
    "Your first brief comes soon." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your first brief comes soon."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的第一份简报很快送达。"}}}},
    "Next brief at %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Next brief at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一份简报在%@"}}}},
    "your computer" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"your computer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑"}}}},
    "connection.sentWaiting" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":", and what you sent goes out."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"，你发出的内容也会送达。"}}}},
    "Your phone could not reach your computer. Make sure Isoform is open and remote access is on, check your internet connection, then try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your phone could not reach your computer. Make sure Isoform is open and remote access is on, check your internet connection, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"手机无法连接到你的电脑。请确认 Isoform 已打开且远程访问已开启，检查网络连接后重试。"}}}},
    "connection.asleepSince": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Asleep since %1$@ · %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从%1$@起睡眠 · %2$@"}}}},
    "connection.causeLastConnected": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ · last connected %2$@"}}}},
    "connection.longAway.directions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your phone hasn't reached your computer in over a day. Check that your computer is on, online, and running Isoform. If it still can't connect, pair again in Settings."}}}},
    "connection.causeAsOf": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ · as of %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$@ · 截至%2$@"}}}},
    "connection.sleepReason.batteryFloor": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"It went to sleep to save its battery (below 20%)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为了省电（电量低于 20%）进入了睡眠。"}}}},
    "connection.sleepReason.batteryFloor.step": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Plug it in, then press any key."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"接上电源，然后按任意键。"}}}},
    "connection.sleepReason.picksUp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform picks up where it left off."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 会从中断处继续。"}}}},
    "connection.sleepReason.lowPower": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Low Power Mode is on."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"低电量模式已开启。"}}}},
    "connection.sleepReason.lowPower.step": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Plug it in, or turn off Low Power Mode."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"接上电源，或关闭低电量模式。"}}}},
    "connection.sleepReason.lidClosed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Its lid is closed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"盖子合上了。"}}}},
    "connection.sleepReason.lidClosed.step": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the lid."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开盖子。"}}}},
    "%@ · made last night at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · made last night at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ · 昨晚 %@ 生成"}}}},
    "%@ · made at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · made at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ · %@ 生成"}}}},
    "%@ · made yesterday at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · made yesterday at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ · 昨天 %@ 生成"}}}},
    "made last night at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"made last night at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"昨晚 %@ 生成"}}}},
    "made yesterday at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"made yesterday at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"昨天 %@ 生成"}}}},
    "made %@ at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"made %@ at %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ %@ 生成"}}}},
    "connection.keepAwakeOffer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"To reach it while it's plugged in, keep it awake for your phone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"接通电源时让电脑保持唤醒，手机就能随时连上它。"}}}},
    "Your computer is asleep.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is asleep."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑在睡眠。"}}}},
    "Your computer went to sleep to save its battery.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer went to sleep to save its battery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑为了省电进入了睡眠。"}}}},
    "Your computer's lid is closed.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer's lid is closed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑合上了。"}}}},
    "Your computer is off.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is off."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已关机。"}}}},
    "Isoform is closed on your computer.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform is closed on your computer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你电脑上的 Isoform 已关闭。"}}}},
    "Your computer isn't answering.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer isn't answering."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑没有响应。"}}}},
    "This iPhone is offline.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This iPhone is offline."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这台 iPhone 已离线。"}}}},
    "Isoform can't connect right now.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform can't connect right now."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 暂时无法连接。"}}}},
    "Your computer is back. Send the reply to %@ now?": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is back. Send the reply to %@ now?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已恢复连接。现在把回复发给 %@ 吗？"}}}},
    "Your computer is back. Send the reply now?": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is back. Send the reply now?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已恢复连接。现在发送这条回复吗？"}}}},
    "This waited a day, so it wasn't sent.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This waited a day, so it wasn't sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这条等了一天，所以没有发出。"}}}},
    "Your message waited a day, so it wasn't sent.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your message waited a day, so it wasn't sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的消息等了一天，所以没有发出。"}}}},
    "Your reply to %@ waited a day, so it wasn't sent.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your reply to %@ waited a day, so it wasn't sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你给 %@ 的回复等了一天，所以没有发出。"}}}},
    "Your reply waited a day, so it wasn't sent.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your reply waited a day, so it wasn't sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的回复等了一天，所以没有发出。"}}}},
    "%lld messages waited a day, so they weren't sent.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld messages waited a day, so they weren't sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%lld 条消息等了一天，所以没有发出。"}}}},
    "Your computer is asleep. Isoform answers when it wakes.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is asleep. Isoform answers when it wakes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑在睡眠。它醒来后 Isoform 就会回答。"}}}},
    "Your computer went to sleep to save its battery. Isoform answers when it wakes.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer went to sleep to save its battery. Isoform answers when it wakes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑为了省电进入了睡眠。它醒来后 Isoform 就会回答。"}}}},
    "Your computer's lid is closed. Isoform answers when you open it.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer's lid is closed. Isoform answers when you open it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑合上了。打开后 Isoform 就会回答。"}}}},
    "Your computer is off. Isoform answers when it's back on.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is off. Isoform answers when it's back on."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已关机。开机后 Isoform 就会回答。"}}}},
    "Isoform is closed on your computer. It answers when you open it.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform is closed on your computer. It answers when you open it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你电脑上的 Isoform 已关闭。打开后它就会回答。"}}}},
    "Your computer isn't answering. Isoform answers when it's back.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer isn't answering. Isoform answers when it's back."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑没有响应。它恢复后 Isoform 就会回答。"}}}},
    "This iPhone is offline. Your message goes out when it's back online.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This iPhone is offline. Your message goes out when it's back online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这台 iPhone 已离线。恢复联网后消息就会发出。"}}}},
    "Isoform can't connect right now. Your message goes out when it does.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform can't connect right now. Your message goes out when it does."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 现在无法连接。连上后消息就会发出。"}}}},
    "Your computer has been asleep since %@. Isoform answers when it wakes.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer has been asleep since %@. Isoform answers when it wakes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑从%@起一直在睡眠。它醒来后 Isoform 就会回答。"}}}},
    "Your computer has been asleep since %@ to save its battery. Isoform answers when it wakes.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer has been asleep since %@ to save its battery. Isoform answers when it wakes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑为了省电，从%@起一直在睡眠。它醒来后 Isoform 就会回答。"}}}},
    "Your computer's lid has been closed since %@. Isoform answers when you open it.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer's lid has been closed since %@. Isoform answers when you open it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑从%@起一直合着。打开后 Isoform 就会回答。"}}}},
    "Your computer has been off since %@. Isoform answers when it's back on.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer has been off since %@. Isoform answers when it's back on."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑从%@起一直关机。开机后 Isoform 就会回答。"}}}},
    "Isoform has been closed on your computer since %@. It answers when you open it.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform has been closed on your computer since %@. It answers when you open it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你电脑上的 Isoform 从%@起一直关闭。打开后它就会回答。"}}}},
    "Your computer has been away since %@. Isoform answers when it's back.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer has been away since %@. Isoform answers when it's back."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑从%@起一直离开。它恢复后 Isoform 就会回答。"}}}},
    "This iPhone has been offline since %@. Your message goes out when it's back online.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This iPhone has been offline since %@. Your message goes out when it's back online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这台 iPhone 从%@起一直离线。恢复联网后消息就会发出。"}}}},
    "Isoform hasn't been able to connect since %@. Your message goes out when it does.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Isoform hasn't been able to connect since %@. Your message goes out when it does."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Isoform 从%@起一直无法连接。连上后消息就会发出。"}}}},
    "Your computer is back. This went out at %@.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is back. This went out at %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已恢复连接。这条消息在 %@ 发出了。"}}}},
    "Your computer is back. These went out at %@.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your computer is back. These went out at %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的电脑已恢复连接。这些消息在 %@ 发出了。"}}}},
