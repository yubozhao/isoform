    "Your messages wait on this phone, in order, as long as it takes. Nothing expires. Undo takes one back and puts its words in the box.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Your messages wait on this phone, in order, as long as it takes. Nothing expires. Undo takes one back and puts its words in the box."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的消息会按顺序留在这台手机上，不论等多久都不会过期。撤销会把一条消息收回，放回输入框。"}}}},
    "You asked at %@ · %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"You asked at %1$@ · %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你在%1$@问 · %2$@"}}}},
    "hold.checked": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"I checked your calendar first: %1$@ was still free, so I held it for %2$@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我先查了日历：%1$@还空着，所以给%2$@留了出来。"}}}},
    "hold.offer.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hold %1$@ for %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"把%1$@留给%2$@"}}}},
